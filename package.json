{
  "name": "soundsense",
  "version": "1.4.5",
  "versionCode": 26,
  "private": true,
  "description": "SoundSense music player",
  "type": "module",
  "scripts": {
    "dev": "node scripts/web.mjs dev beta",
    "dev:stable": "node scripts/web.mjs dev stable",
    "dev:beta": "node scripts/web.mjs dev beta",
    "build": "node scripts/web.mjs build stable",
    "build:stable": "node scripts/web.mjs build stable",
    "build:beta": "node scripts/web.mjs build beta",
    "build:all": "node scripts/web.mjs build all",
    "preview": "node scripts/web.mjs preview stable",
    "preview:beta": "node scripts/web.mjs preview beta",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "node scripts/check-colors.mjs && node scripts/check-boundaries.mjs",
    "test": "vitest run --config config/vite.config.ts",
    "test:ui": "playwright test --config config/playwright/ui.config.ts",
    "test:channels": "npm run build:all && node scripts/check-release-bundles.mjs && playwright test --config config/playwright/channels.config.ts",
    "test:performance": "playwright test --config config/playwright/performance.config.ts",
    "test:profile": "playwright test --config config/playwright/profile.config.ts",
    "screenshots": "npm run test:ui -- tests/ui/screenshots.spec.ts tests/ui/appearance.spec.ts --grep capture",
    "android": "node scripts/android.mjs run beta",
    "android:stable": "node scripts/android.mjs run stable",
    "android:beta": "node scripts/android.mjs run beta",
    "android:apk": "node scripts/android.mjs apk stable",
    "android:apk:stable": "node scripts/android.mjs apk stable",
    "android:apk:beta": "node scripts/android.mjs apk beta",
    "android:setup": "node scripts/setup-android.mjs",
    "desktop": "node scripts/desktop.mjs dev beta",
    "desktop:stable": "node scripts/desktop.mjs dev stable",
    "desktop:app": "node scripts/desktop.mjs app stable",
    "desktop:app:beta": "node scripts/desktop.mjs app beta",
    "desktop:appimage": "node scripts/desktop.mjs appimage stable",
    "desktop:appimage:beta": "node scripts/desktop.mjs appimage beta",
    "desktop:setup": "node scripts/setup-desktop.mjs",
    "release": "node scripts/release/publish.mjs",
    "release:stable": "node scripts/release/publish.mjs --channel=stable",
    "release:beta": "node scripts/release/publish.mjs --channel=beta",
    "plugin:pack": "node scripts/pack-plugin.mjs",
    "plugin:catalog": "node scripts/build-catalog.mjs"
  },
  "devDependencies": {
    "@capacitor/cli": "7.6.10",
    "@playwright/test": "1.58.2",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@types/node": "^22.10.0",
    "electron": "45.2.3",
    "electron-builder": "26.18.0",
    "svelte": "5.57.3",
    "svelte-check": "^4.4.2",
    "typescript": "^5.7.2",
    "vite": "6.4.5",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@capacitor/android": "7.6.10",
    "@capacitor/app": "^7.1.0",
    "@capacitor/clipboard": "^7.0.4",
    "@capacitor/core": "7.6.10",
    "@capacitor/haptics": "^7.0.5",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "1.8.0",
    "fflate": "^0.8.3",
    "hls.js": "^1.6.15",
    "music-metadata": "^11.16.1",
    "peerjs": "1.5.5",
    "youtubei.js": "18.3.0"
  },
  "engines": {
    "node": ">=20.18.0"
  }
}
