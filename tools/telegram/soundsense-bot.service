[Unit]
Description=SoundSense Telegram channel bot
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/soundsense-bot
EnvironmentFile=/etc/soundsense-bot.env
Environment=STATE_DIR=/var/lib/soundsense-bot
ExecStart=/usr/bin/node watch.mjs
Restart=always
RestartSec=10
User=soundsensebot
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/soundsense-bot

[Install]
WantedBy=multi-user.target
