{
  "appId": "app.soundsense",
  "productName": "SoundSense",
  "copyright": "SoundSense",
  "asar": true,
  "npmRebuild": false,
  "nodeGypRebuild": false,
  "buildDependenciesFromSource": false,
  "files": [
    "**/*",
    "!node_modules{,/**/*}"
  ],
  "linux": {
    "target": [
      "AppImage"
    ],
    "icon": "assets/branding/icons",
    "category": "AudioVideo;Audio;Player",
    "executableName": "soundsense",
    "synopsis": "Personal music player",
    "syncDesktopName": true,
    "extraResources": [
      {
        "from": ".toolchain/ffmpeg",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg",
          "LICENSE.md",
          "COPYING.LGPLv2.1"
        ]
      }
    ]
  },
  "publish": null,
  "toolsets": {
    "appimage": "1.0.3"
  },
  "appImage": {
    "desktop": {
      "entry": {
        "Name": "SoundSense",
        "Categories": "AudioVideo;Audio;Player;",
        "StartupWMClass": "soundsense",
        "Keywords": "music;player;audio;",
        "GenericName": "Music Player",
        "Comment": "Personal music player"
      }
    }
  },
  "win": {
    "icon": "assets/branding/icons/256x256.png",
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "extraResources": [
      {
        "from": ".toolchain/ffmpeg-win32-x64",
        "to": "ffmpeg",
        "filter": [
          "ffmpeg.exe",
          "LICENSE.md",
          "COPYING.LGPLv2.1"
        ]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true
  }
}
